import numpy as np

# Input array from the user
array1 = np.array(list(map(int,input().split())))

# Searching
search_value = int(input())
count_value = int(input())
broadcast_value = int(input())

# Find indices where value matches in array
indices = np.where(array1 == search_value)

# Count occurrences in array
count = np.count_nonzero(array1 == count_value)

# Broadcasting addition
broadcasted_array = array1 + broadcast_value

# Sort the first array
sorted_array = np.sort(array1)

print(indices[0])
print(count)
print(broadcasted_array)
print(sorted_array)
