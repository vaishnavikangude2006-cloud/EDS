import pandas as pd
import matplotlib.pyplot as plt

df = pd.read_csv('titanic.csv')

fig, axes = plt.subplots(3,2, figsize=(12,12))

count_df = df['Pclass'].value_counts().sort_index()
count_gender = df['Gender'].value_counts().sort_index()

axes[0,0].bar(count_df.index, count_df.values)
axes[0,0].set_title('Passenger Class Distribution')
axes[0,0].set_xlabel('Pclass')
axes[0,0].set_ylabel('Count')

axes[0,1].pie(count_gender.values,
              labels=['male','female'],
              autopct='%1.1f%%')
axes[0,1].set_title('Gender Distribution')

axes[1,0].hist(df['Age'], bins=8)
axes[1,0].set_title('Age Distribution')
axes[1,0].set_xlabel('Age')
axes[1,0].set_ylabel('Frequency')

survival_count = df['Survived'].value_counts().sort_index()
axes[1,1].bar(survival_count.index, survival_count.values)
axes[1,1].set_title('Survival Count')
axes[1,1].set_xlabel('Survived')
axes[1,1].set_ylabel('Count')

axes[2,0].scatter(df['Age'], df['Fare'])
axes[2,0].set_title('Fare vs Age')
axes[2,0].set_xlabel('Age')
axes[2,0].set_ylabel('Fare')

axes[2,1].axis('off')

plt.tight_layout()
plt.show()
